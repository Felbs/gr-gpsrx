options:
  parameters:
    id: gpsrx_replay
    title: 'GPS receiver: capture file to a fix'
    author: gr-gpsrx
    generate_options: no_gui
    output_language: python
    category: '[GRC Hier Blocks]'
    run: 'True'
    run_options: run
    gen_cmake: 'On'
    description: File -> Receiver (one block) -> Status.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: 2.048e6
    comment: '2.048 MS/s: 2 samples per chip, the tested rate'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 12
    rotation: 0
    state: enabled
- name: capture
  id: parameter
  parameters:
    label: Capture file (.cs16, interleaved int16 I/Q)
    type: str
    value: '"capture.cs16"'
    short_id: c
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 400
    - 12
    rotation: 0
    state: enabled
- name: fix_file
  id: parameter
  parameters:
    label: Fix file (keep it out of any repository)
    type: str
    value: '""'
    short_id: o
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 12
    rotation: 0
    state: enabled
- name: src
  id: blocks_file_source
  parameters:
    file: capture
    type: short
    repeat: 'False'
    offset: '0'
    length: '0'
    begin_tag: pmt.PMT_NIL
    comment: int16 I,Q pairs
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 220
    rotation: 0
    state: enabled
- name: to_c
  id: blocks_interleaved_short_to_complex
  parameters:
    vector_input: 'False'
    swap: 'False'
    scale_factor: '32768.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 232
    rotation: 0
    state: enabled
- name: rx
  id: gpsrx_receiver
  parameters:
    samp_rate: samp_rate
    n_channels: '8'
    interval_s: '100.0'
    threshold: '2.5'
    iono_file: '""'
    fix_file: fix_file
    hold: 'True'
    engine: '''auto'''
    eph_file: '""'
    smoothing: '100'
    kf_vel_sd: '4.0'
    comment: Acquisition -> 8 x (Channel -> Nav Decoder) -> PVT
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 180
    rotation: 0
    state: enabled
- name: status
  id: gpsrx_status
  parameters:
    every_s: '2.0'
    log_file: '""'
    comment: quality only; the position goes to the fix file
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 900
    - 180
    rotation: 0
    state: enabled
connections:
- - src
  - '0'
  - to_c
  - '0'
- - to_c
  - '0'
  - rx
  - '0'
- - rx
  - sky
  - status
  - sky
- - rx
  - status
  - status
  - status
- - rx
  - obs
  - status
  - obs
- - rx
  - nav
  - status
  - nav
- - rx
  - fix
  - status
  - fix
metadata:
  file_format: 1
  grc_version: 3.10.12.0
