    rotation: 0
    state: enabled
- name: ch4
  id: gpsrx_channel
  parameters:
    samp_rate: samp_rate
    slot: '4'
    pll_bw: '18.0'
    dll_bw: '2.0'
    obs_every_ms: '1000'
    comment: 'slot 4: NCO, E/P/L, PLL, DLL; counts code epochs'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 780
    rotation: 0
    state: enabled
- name: nav4
  id: gpsrx_nav_decoder
  parameters:
    slot: '4'
    comment: bits -> words -> subframes -> anchor
  states:
