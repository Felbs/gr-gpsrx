options:
  parameters:
    id: gpsrx_canvas
    title: GPS receiver, block by block
    author: gr-gpsrx
    generate_options: no_gui
    output_language: python
    category: '[GRC Hier Blocks]'
    run: 'True'
    run_options: run
    gen_cmake: 'On'
    description: Acquisition -> Channels -> Nav Decoders -> PVT -> Status, every wire
      visible.
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    value: 2.048e6
    comment: '2.048 MS/s: 2 samples per chip, the tested rate'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 230
    - 12
    rotation: 0
    state: enabled
- name: capture
  id: parameter
  parameters:
    label: Capture file (.cs16, interleaved int16 I/Q)
    type: str
    value: '"capture.cs16"'
    short_id: c
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 400
    - 12
    rotation: 0
    state: enabled
- name: fix_file
  id: parameter
  parameters:
    label: Fix file (keep it out of any repository)
    type: str
    value: '""'
    short_id: o
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 12
    rotation: 0
    state: enabled
- name: src
  id: blocks_file_source
  parameters:
    file: capture
    type: short
    repeat: 'False'
    offset: '0'
    length: '0'
    begin_tag: pmt.PMT_NIL
    comment: int16 I,Q pairs
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 300
    rotation: 0
    state: enabled
- name: to_c
  id: blocks_interleaved_short_to_complex
  parameters:
    vector_input: 'False'
    swap: 'False'
    scale_factor: '32768.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 300
    - 312
    rotation: 0
    state: enabled
- name: acq
  id: gpsrx_acquisition
  parameters:
    samp_rate: samp_rate
    n_slots: '6'
    interval_s: '100.0'
    threshold: '2.5'
    n_noncoh: '100'
    snapshot_ms: '110'
    settle_s: '0.5'
    hold: 'True'
    comment: finds the satellites; assigns each to a Channel slot
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 100
    rotation: 0
    state: enabled
- name: pvt
  id: gpsrx_pvt
  parameters:
    samp_rate: samp_rate
    average: '15'
    iono_file: '""'
    fix_file: fix_file
    comment: period counts + anchors -> pseudoranges -> least squares
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1300
    - 660
    rotation: 0
    state: enabled
- name: status
  id: gpsrx_status
  parameters:
    every_s: '2.0'
    log_file: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1560
    - 660
    rotation: 0
    state: enabled
- name: ch0
  id: gpsrx_channel
  parameters:
    samp_rate: samp_rate
    slot: '0'
    pll_bw: '18.0'
    dll_bw: '2.0'
    obs_every_ms: '1000'
    comment: 'slot 0: NCO, E/P/L, PLL, DLL; counts code epochs'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 300
    rotation: 0
    state: enabled
- name: nav0
  id: gpsrx_nav_decoder
  parameters:
    slot: '0'
    comment: bits -> words -> subframes -> anchor
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1020
    - 300
    rotation: 0
    state: enabled
- name: ch1
  id: gpsrx_channel
  parameters:
    samp_rate: samp_rate
    slot: '1'
    pll_bw: '18.0'
    dll_bw: '2.0'
    obs_every_ms: '1000'
    comment: 'slot 1: NCO, E/P/L, PLL, DLL; counts code epochs'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 420
    rotation: 0
    state: enabled
- name: nav1
  id: gpsrx_nav_decoder
  parameters:
    slot: '1'
    comment: bits -> words -> subframes -> anchor
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1020
    - 420
    rotation: 0
    state: enabled
- name: ch2
  id: gpsrx_channel
  parameters:
    samp_rate: samp_rate
    slot: '2'
    pll_bw: '18.0'
    dll_bw: '2.0'
    obs_every_ms: '1000'
    comment: 'slot 2: NCO, E/P/L, PLL, DLL; counts code epochs'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 540
    rotation: 0
    state: enabled
- name: nav2
  id: gpsrx_nav_decoder
  parameters:
    slot: '2'
    comment: bits -> words -> subframes -> anchor
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1020
    - 540
    rotation: 0
    state: enabled
- name: ch3
  id: gpsrx_channel
  parameters:
    samp_rate: samp_rate
    slot: '3'
    pll_bw: '18.0'
    dll_bw: '2.0'
    obs_every_ms: '1000'
    comment: 'slot 3: NCO, E/P/L, PLL, DLL; counts code epochs'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 660
    rotation: 0
    state: enabled
- name: nav3
  id: gpsrx_nav_decoder
  parameters:
